# Copy to .env and fill in (never commit .env)

# --- Terminal intraday (cloud deploy) ---
# Provider: vendor (recommended) | auto | thetadata
# Cloud/Railway: set vendor + GEXBOT/UW keys; keep THETADATA_* for rollback only.
# TERMINAL_CHAIN_PROVIDER=vendor

# Vendor mode (GEXBot Quant + Unusual Whales) — see docs/terminal/GEXBOT_MIGRATION_PLAN.md
# GEXBOT_API_KEY=gexbot_custom_...
# UNUSUAL_WHALES_API_KEY=...

# Legacy ThetaData (rollback)
# THETADATA_CREDENTIALS_FILE=C:\path\to\creds.txt
# THETADATA_EMAIL=your-email@example.com
# THETADATA_PASSWORD=your-password

# Cloud deploy (Railway / Render / Docker) — see docs/DEPLOY.md
# TERMINAL_HISTORY_DAYS=14
# TERMINAL_AUTH_USER=admin
# TERMINAL_AUTH_PASSWORD=choose-a-strong-password
# TERMINAL_PREWARM_HIST=1
# TERMINAL_GEXBOT_WS=1
# TERMINAL_GEXBOT_WS_GROUPS=SPX_classic_gex_zero,SPX_orderflow_orderflow
# TERMINAL_VENDOR_LIVE_POLLER=0
# TERMINAL_RESONANCE_FLIP_TOL=15
